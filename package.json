{
  "name": "gft-merge",
  "version": "0.1.1",
  "description": "Merge AI agent sessions into pools and start a new session from a pool in any tool.",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "codex",
    "session",
    "context",
    "merge"
  ],
  "homepage": "https://github.com/CoralLips/gft-merge#readme",
  "bugs": {
    "url": "https://github.com/CoralLips/gft-merge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoralLips/gft-merge.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gft-merge": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "home.mjs",
    "openLink.mjs",
    "pools.mjs",
    "server.mjs",
    "tools/",
    "web/",
    "skill/",
    "README_ZH.md"
  ],
  "scripts": {
    "start": "node cli.mjs open",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "gpt-tokenizer": "4.0.0"
  }
}
